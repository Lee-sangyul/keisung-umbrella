# Copy to .env and change the password. Never commit your actual .env file.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=CHANGE_ME_TO_A_LONG_RANDOM_PASSWORD

# Usually leave blank. If Codespaces' proxy reports an invalid request
# origin, paste the exact HTTPS URL from the Codespaces Ports tab here.
# Example: https://YOUR-CODESPACE-8000.app.github.dev
APP_ORIGIN=

# Use true on HTTPS. Codespaces HTTPS origins also force Secure cookies.
SECURE_COOKIES=true

# SQLite database directory (persist this folder in hosting).
DATA_DIR=./data
